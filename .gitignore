# Docker
.dockerignore

# Backups
*.backup.*
.backup-original/

# Logs
*.log

# Environment
.env
.env.local

# Node (para cuando migres a Nuxt)
node_modules/
.nuxt/
.output/

# VuePress build (el Dockerfile lo copia desde el contexto sin necesidad de commitearlo)
src/.vuepress/dist/
src/.vuepress/.temp/
src/.vuepress/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
